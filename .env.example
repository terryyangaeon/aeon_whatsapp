# Copy to .env for local docker compose use.
# On Coolify, set the same keys in the app's Environment Variables UI.

# API key the dashboard sends in the X-Api-Key header.
WHATSAPP_API_KEY=change-me-to-the-real-key

# WAHA Core supports exactly ONE session; "default" is the convention.
WAHA_SESSION=default

# Bind address. Keep 0.0.0.0 so Docker reaches the container.
WHATSAPP_API_HOSTNAME=0.0.0.0

# Web dashboard credentials (https://<host>/dashboard).
WAHA_DASHBOARD_USERNAME=aeon
WAHA_DASHBOARD_PASSWORD=change-me

# Swagger UI credentials (https://<host>/).
WHATSAPP_SWAGGER_USERNAME=aeon
WHATSAPP_SWAGGER_PASSWORD=change-me

# JSON or TEXT. JSON is easier to parse in Coolify logs.
WAHA_LOG_FORMAT=JSON

# WEBJS is the free/Core engine. NOWEB and GOWS are Plus-only.
WHATSAPP_DEFAULT_ENGINE=WEBJS
